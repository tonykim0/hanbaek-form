{
  "permissions": {
    "allow": [
      "Bash(unzip -p *)",
      "Bash(unzip -l *)",
      "Bash(md5 *)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx playwright screenshot *)",
      "Bash(qlmanage -t *)",
      "Bypass permissions"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-git.sh",
            "if": "Bash(git *)",
            "timeout": 10,
            "statusMessage": "git 스테이징 가드 확인 중"
          }
        ]
      }
    ]
  }
}
